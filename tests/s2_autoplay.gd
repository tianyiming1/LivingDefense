func _ready() -> void:
	Engine.time_scale = TIME_SCALE
	started_ms = Time.get_ticks_msec()
	get_tree().set_meta("selected_race", "fungus")
	main = load("res://main.tscn").instantiate()
	add_child(main)
	main.current_race = "fungus"
	main.hud.set_race("fungus")
	await get_tree().physics_frame
	await _run()
	_finish()

